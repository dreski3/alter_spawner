{
  "name": "mind-monorepo",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "node --test \"packages/core/test/**/*.test.js\"",
    "test:unit": "node --test \"packages/core/test/unit/**/*.test.js\"",
    "test:integration": "node --test \"packages/core/test/integration/**/*.test.js\"",
    "test:live:nested-spawn": "MIND_LIVE_TESTS=1 node --test packages/core/test/integration/nested-spawn.test.js",
    "test:live:adaptive": "MIND_LIVE_ADAPTIVE_TESTS=1 node --test packages/core/test/integration/adaptive-catalog.test.js",
    "benchmark:validate": "node benchmarks/task-set.mjs",
    "benchmark:router-fixtures": "node benchmarks/run-router-cases.mjs",
    "benchmark:nested-fixtures": "node benchmarks/run-nested.mjs",
    "benchmark:compare": "node benchmarks/run-comparison.mjs",
    "benchmark:router-compare": "node benchmarks/compare-router-strategies.mjs",
    "benchmark:frontier-nested": "node benchmarks/run-frontier-nested.mjs",
    "benchmark:frontier-router": "node benchmarks/compare-frontier-routers.mjs",
    "benchmark:candidate-policies": "node benchmarks/compare-candidate-policies.mjs",
    "benchmark:apply-ratings": "node benchmarks/apply-blind-ratings.mjs",
    "check": "node scripts/check.mjs",
    "pack:check": "npm pack --dry-run --json --cache .npm-cache --workspace packages/core && npm pack --dry-run --json --cache .npm-cache --workspace packages/cli",
    "validate": "npm run check && npm test && npm run pack:check"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
