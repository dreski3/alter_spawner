{
  "name": "mind-monorepo",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "mind-monorepo",
      "license": "MIT",
      "workspaces": [
        "packages/*"
      ],
      "engines": {
        "node": ">=22.13.0"
      }
    },
    "node_modules/@mind/core": {
      "resolved": "packages/core",
      "link": true
    },
    "node_modules/mind": {
      "resolved": "packages/cli",
      "link": true
    },
    "packages/cli": {
      "name": "mind",
      "version": "0.1.0",
      "bin": {
        "mind": "dist/cli/index.js"
      },
      "engines": {
        "node": ">=22.13.0"
      }
    },
    "packages/core": {
      "name": "@mind/core",
      "version": "0.1.0",
      "engines": {
        "node": ">=22.13.0"
      }
    }
  }
}
