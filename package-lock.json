{
  "name": "mind-monorepo",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "mind-monorepo",
      "workspaces": [
        "packages/*"
      ]
    },
    "node_modules/@mind/core": {
      "resolved": "packages/core",
      "link": true
    },
    "node_modules/mind": {
      "resolved": "packages/cli",
      "link": true
    },
    "packages/cli": {
      "name": "mind",
      "version": "0.1.0",
      "dependencies": {
        "@mind/core": "^0.1.0"
      },
      "bin": {
        "mind": "src/index.js"
      }
    },
    "packages/core": {
      "name": "@mind/core",
      "version": "0.1.0"
    }
  }
}
